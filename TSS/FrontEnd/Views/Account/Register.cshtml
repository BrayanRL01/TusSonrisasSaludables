@model FrontEnd.Models.UserViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/Authorize/_RegisterLayout.cshtml";
}

<style>
    .text-center {
        align-items: center !important;
        justify-content: center;
        align-content: center;
    }
</style>

<div class="card o-hidden border-0 shadow-lg my-5">
    <div class="card-body p-0">
        <!-- Nested Row within Card Body -->
        <div class="row">
            @* <div class="col-lg-5 d-none d-lg-block bg-register-image"></div> *@
            <div class="col-lg-12">
                <div class="p-5">
                    @if (TempData.ContainsKey("Error"))
                    {
                        <div class="alert alert-danger" role="alert">
                            @TempData["Error"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }
                    <div class="text-center">
                        <h1 class="h4 text-gray-900 mb-4">¡Crear Cuenta!</h1>
                    </div>
                    <form asp-action="Register" id="Registration" class="row g-3">
                        <div class="col-md-6">
                            @Html.DropDownListFor(model => model.TypeId, (SelectList)ViewBag.IDTypes, "Seleccione un tipo", new { @class = "form-control" })
                            <span asp-validation-for="TypeId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            @Html.DropDownListFor(model => model.GenreId, (SelectList)ViewBag.Genres, "Seleccione un género", new { @class = "form-control" })
                            <span asp-validation-for="GenreId" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            @Html.DropDownListFor(model => model.ProvinceId, (SelectList)ViewBag.Provinces, "Seleccione una provincia", new { @class = "form-control" })
                            <span asp-validation-for="ProvinceId" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <input asp-for="IdNumber" class="form-control" placeholder="Número de Cédula" required>
                            <span asp-validation-for="IdNumber" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <input asp-for="UserName" class="form-control" placeholder="Nombre" required>
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <input asp-for="FirstName" class="form-control" placeholder="Primer Apellido" required>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <input asp-for="LastName" class="form-control" placeholder="Segundo Apellido" required>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-12">
                            <input asp-for="BirthDate" class="form-control" placeholder="Fecha de Nacimiento">
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <input asp-for="Email" class="form-control" placeholder="Correo Electrónico" required>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Número Telefónico" required>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-12">
                            <textarea asp-for="UserAddress" class="form-control" placeholder="Dirección" rows="3" required></textarea>
                            <span asp-validation-for="UserAddress" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <input asp-for="PasswordHash" class="form-control" placeholder="Contraseña" required>
                            <span asp-validation-for="PasswordHash" class="text-danger"></span>
                        </div>
                        <div class="g-recaptcha" data-sitekey="6LeEVPsoAAAAAIV04PkyxMomhwV6AFnFQXdfoyp5"></div>
                        <br />
                        <div class="form-group text-center">
                            <input type="submit" id="login" value="Crear Usuario" class="btn btn-primary text-center" />
                        </div>
                    </form>
                    <div class="text-center">
                        <a class="small" asp-controller="Account" asp-action="ResetPassword">¿Olvido su contraseña?</a> <br />
                        <a class="small" asp-controller="Account" asp-action="Login">¿Ya tiene una cuenta? ¡Ingrese aqui!</a> <br />
                        <a class="small" asp-controller="Home" asp-action="Index">Regresar al Menú Principal</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}