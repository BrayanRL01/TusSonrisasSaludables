@model FrontEnd.Models.EmailModel

@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/Authorize/_PasswordLayout.cshtml";
}

<style>

</style>

<center>
    <div class="container">
        <!-- Outer Row -->
        <div class="row justify-content-center">

            <div class="col-xl-10 col-lg-12 col-md-9">

                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body">
                        <!-- Nested Row within Card Body -->
                        <div>
                            <div class="col-lg-10">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-2">¿Olvidó su contraseña?</h1>
                                        <p class="mb-4">
                                            Lo entendemos, suele suceder en ocasiones.
                                            ¡Ingresa su correo electrónico para enviarle su nueva contraseña!
                                        </p>
                                    </div>
                                    <form asp-action="ResetPassword">
                                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                        <div class="form-group">
                                            <label asp-for="To" class="control-label"></label>
                                            <input asp-for="To" class="form-control" />
                                            <span asp-validation-for="To" class="text-danger"></span>
                                        </div>
                                        <div class="form-group">
                                            <input type="submit" value="Enviar Correo" class="btn btn-primary" />
                                        </div>
                                    </form>
                                    <hr>
                                    <div class="text-center">
                                        <a class="small" asp-controller="Account" asp-action="Register">¡Crear Una Cuenta!</a>
                                    </div>
                                    <div class="text-center">
                                        <a class="small" asp-controller="Account" asp-action="Login">¿Ya tienes una cuenta? Inicie Sesión</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</center>
