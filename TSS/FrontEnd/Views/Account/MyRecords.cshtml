@model IEnumerable<FrontEnd.Models.VWRecordViewModel>

@{
    ViewData["Title"] = "MyRecords";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="padding: 30px; width: 100%;">
    @if (TempData.ContainsKey("Message"))
    {
        <div class="alert alert-success" role="alert">
            @TempData["Message"]
        </div>
    }
    else @if (TempData.ContainsKey("Error"))
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }
    <center><h1>Mis Registros</h1></center>
    @if (Model.Count() != 0)
    {
        <table class="table">
            <thead>
                <tr>
                    @*                     <th>
                @Html.DisplayNameFor(model => model.PatientName)
                </th> *@
                    <th>
                        @Html.DisplayNameFor(model => model.DoctorName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ProcedureName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Diagnoses)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Symptoms)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Treatment)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RecordDate)
                    </th>
                </tr>
            </thead>
            <br />
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @*                         <td>
                @Html.DisplayFor(modelItem => item.PatientName)
                </td> *@
                        <td>
                            @Html.DisplayFor(modelItem => item.DoctorName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ProcedureName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Diagnoses)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Symptoms)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Treatment)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.RecordDate)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <hr />
        <center>
            <h1>No posee registros previos de citas realizadas.</h1>
        </center>
    }
</div>