<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <title>Sonrisas Saludables</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Free HTML Templates" name="keywords">
    <meta content="Free HTML Templates" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/UI/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/lib/UI/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/UI/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="~/lib/UI/twentytwenty/twentytwenty.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/UI/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/UI/style.css" rel="stylesheet">
</head>

<body>
    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary m-1" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
        <div class="spinner-grow text-dark m-1" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
        <div class="spinner-grow text-secondary m-1" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
    </div>
    <!-- Spinner End -->
    <!-- Topbar Start -->
    <div class="container-fluid bg-light ps-5 pe-0 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-md-6 text-center text-lg-start mb-2 mb-lg-0">
                <div class="d-inline-flex align-items-center">
                    <small class="py-2"><i class="far fa-clock text-primary me-2"></i>Horario de Lunes a Viernes: 9:00 am - 7:00 pm, Sábados: 9:00 am - 12:00 md, Domingos Cerrados.</small>
                </div>
            </div>
            <div class="col-md-6 text-center text-lg-end">
                <div class="position-relative d-inline-flex align-items-center bg-primary text-white top-shape px-5">
                    <div class="me-3 pe-3 border-end py-2">
                        <p class="m-0"><i class="fa fa-envelope-open me-2"></i>tusonrisasaludables@gmail.com</p>
                    </div>
                    <div class="py-2">
                        <p class="m-0"><i class="fa fa-phone-alt me-2"></i>2221-4316</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar End -->
    <!-- Navbar Start -->
    <nav class="navbar navbar-expand-lg bg-white navbar-light shadow-sm px-5 py-3 py-lg-0">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand p-0">
            <h1 class="m-0 text-primary"><i class="fa fa-tooth me-2"></i>Sonrisas Saludables</h1>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">Inicio</a>
                <a href="#" class="nav-item nav-link">Acerca</a>
                <a href="#" class="nav-item nav-link">Servicios</a>
                @*                 <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Productos</a>
                <div class="dropdown-menu m-0">
                @* <a href="price.html" class="dropdown-item">Pricing Plan</a>
                <a href="team.html" class="dropdown-item">Conoce nuestros profesionales</a>
                <a href="testimonial.html" class="dropdown-item">Testimonios</a>
                <a href="appointment.html" class="dropdown-item">Citas</a>
                @*<a href="Products.Index" class="dropdown-item">Products</a>
                <a asp-controller="Account" asp-action="Login" class="dropdown-item">Iniciar Sesión</a>
                <a asp-controller="Account" asp-action="Register" class="dropdown-item">Registrarse</a>
                <a asp-controller="Account" asp-action="LogOut" class="dropdown-item">Cerrar Sesión</a>
                </div>
                </div> *@
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Perfil</a>
                    <div class="dropdown-menu m-0">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item">Cambiar Contraseña</a>
                            <a asp-controller="Account" asp-action="EditProfile" class="dropdown-item">Mí Información</a>
                            <a asp-controller="Account" asp-action="MyAppointments" class="dropdown-item">Mis Citas</a>
                            <a asp-controller="Account" asp-action="MyRecords" class="dropdown-item">Mis Registros</a>
                            <a asp-controller="Account" asp-action="LogOut" class="dropdown-item">Cerrar Sesión</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="dropdown-item">Iniciar Sesión</a>
                            <a asp-controller="Account" asp-action="Register" class="dropdown-item">Registrarse</a>
                        }
                    </div>
                </div>
                <a href="contact.html" class="nav-item nav-link">Contacto</a>
            </div>
            <button type="button" class="btn text-dark" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fa fa-search"></i></button>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-primary py-2 px-4 ms-3">Citas</a>
        </div>
    </nav>
    <!-- Navbar End -->
    @RenderBody()
    <!-- Newsletter End -->
    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-light py-5 wow fadeInUp" data-wow-delay="0.3s" style="margin-top: 200px;">
        <div class="container pt-5">
            <div class="row g-5 pt-4">
                <div class="col-lg-3 col-md-6">
                    <h3 class="text-white mb-4">Opciones</h3>
                    <div class="d-flex flex-column justify-content-start">
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Inicio</a>
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Acerca</a>
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Servicios</a>
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Productos</a>
                        <a class="text-light" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Contacto</a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h3 class="text-white mb-4">Servicios</h3>
                    <div class="d-flex flex-column justify-content-start">
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Profesionales</a>
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Procedimientos</a>
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Valoración</a>
                        <a class="text-light mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Cotización</a>
                        <a class="text-light" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Cuidados</a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h3 class="text-white mb-4">Contacto</h3>
                    <p class="mb-2"><i class="bi bi-geo-alt text-primary me-2"></i>San José, Costa Rica</p>
                    <p class="mb-2"><i class="bi bi-envelope-open text-primary me-2"></i>info@example.com</p>
                    <p class="mb-0"><i class="bi bi-telephone text-primary me-2"></i>2221-4316</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h3 class="text-white mb-4">Siguenos</h3>
                    <div class="d-flex">
                        <a class="btn btn-lg btn-primary btn-lg-square rounded me-2" href="#"><i class="fab fa-twitter fw-normal"></i></a>
                        <a class="btn btn-lg btn-primary btn-lg-square rounded me-2" href="#"><i class="fab fa-facebook-f fw-normal"></i></a>
                        <a class="btn btn-lg btn-primary btn-lg-square rounded me-2" href="#"><i class="fab fa-linkedin-in fw-normal"></i></a>
                        <a class="btn btn-lg btn-primary btn-lg-square rounded" href="#"><i class="fab fa-instagram fw-normal"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid text-light py-4" style="background: #051225;">
        <div class="container">
            <div class="row g-0">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-md-0">&copy; <a class="text-white border-bottom" href="#">Sonrisas Saludables @DateTime.Now.Year</a>. Todos los derechos reservados.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer End -->
    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded back-to-top"><i class="bi bi-arrow-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/UI/wow/wow.min.js"></script>
    <script src="~/lib/UI/easing/easing.min.js"></script>
    <script src="~/lib/UI/waypoints/waypoints.min.js"></script>
    <script src="~/lib/UI/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/lib/UI/tempusdominus/js/moment.min.js"></script>
    <script src="~/lib/UI/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="~/lib/UI/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>
    <script src="~/lib/UI/twentytwenty/jquery.event.move.js"></script>
    <script src="~/lib/UI/twentytwenty/jquery.twentytwenty.js"></script>

    <!-- Template Javascript -->
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

