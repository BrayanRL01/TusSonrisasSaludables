@model FrontEnd.Models.VWProductViewModel

@{
    ViewData["Title"] = "DeleteProduct";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

@*<center><h1>Eliminar Producto</h1></center>*@

<center><h3>¿Seguro que desea eliminar?</h3></center>
<div style="text-align: center; padding-left:180px;">
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BrandName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BrandName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CategoryName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CategoryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProductName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProductName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UnitPrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UnitPrice)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Stock)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Stock)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProductImage)
        </dt>
        <dd class="col-sm-10">
            <partial name="Photo/_ProductPhotoView" model="Model" />
        </dd>
    </dl>
</div>
<div style="text-align: center;">
    <form asp-action="DeleteProduct">
        @Html.HiddenFor(Model => Model.ProductId)
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <button class="btn btn-primary" asp-action="Products">Regresar a Productos</button>
        @*<a asp-action="Products">Volver a Productos</a>*@
    </form>
</div>