@model IEnumerable<FrontEnd.Models.VWProductViewModel>
@using Microsoft.AspNetCore.Mvc.ViewFeatures;
@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<h1>Producto</h1>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        @if (TempData["Message"] != null)
        {
            <p>
                @TempData["Message"]
            </p>

        }
        <h6 class="m-0 font-weight-bold text-primary">Lista de Categorías</h6>
        <br />
        <a class="m-0 font-weight-bold text-primary" asp-action="CreateProduct">Crear Producto</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>

                        <th>
                            @Html.DisplayNameFor(model => model.BrandName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.CategoryName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProductName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UnitPrice)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Stock)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProductImage)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.BrandName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CategoryName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProductName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UnitPrice)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Stock)
                            </td>
                            <td>
                                <partial name="Photo/_ProductPhotoView" model="item" />
                            </td>
                            <td>
                                @Html.ActionLink("Edit", "EditProduct", new { id=item.ProductId }) |
                                @Html.ActionLink("Details", "ProductDetails", new { id=item.ProductId }) |
                                @Html.ActionLink("Delete", "DeleteProduct", new { id=item.ProductId })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

