@model FrontEnd.Models.ProductViewModel

@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center><h1>Crear Producto</h1></center>
@*<h4>ProductViewModel</h4>*@

<hr />
<div class="row">
    <div class="col">
        <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col">
                @*<label asp-for="BrandId" class="form-label"></label>*@
                @Html.DropDownListFor(model => model.BrandId, (SelectList)ViewBag.Brands, "Seleccione una marca", new { @class = "form-control" })
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                @* <label asp-for="CategoryId" class="form-label"></label>*@
                @Html.DropDownListFor(model => model.CategoryId, (SelectList)ViewBag.Categories, "Seleccione una categoría", new { @class = "form-control" })
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                @*<label asp-for="ProductName" class="control-label"></label>*@
                <input asp-for="ProductName" class="form-control" placeholder="Nombre de Producto" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                @*<label asp-for="ProductDescription" class="control-label"></label>*@
                <input asp-for="ProductDescription" class="form-control" placeholder="Descripción del Producto" />
                <span asp-validation-for="ProductDescription" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="UnitPrice" class="control-label"></label>
                <input asp-for="UnitPrice" class="form-control" placeholder="Precio" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" placeholder="Disponible" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <input type="file" asp-for="ProductImage" class="form-control" name="files" />
                <span asp-validation-for="ProductImage" class="text-danger"></span>
            </div>
            <br />
            <div style="text-align: center;">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <button class="btn btn-primary" asp-action="Products">Regresar a Producto</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}