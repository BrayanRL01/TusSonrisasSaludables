@model FrontEnd.Models.ProcedureViewModel

@{
    ViewData["Title"] = "EditProcedure";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center>
<h1>Editar Procedimiento</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditProcedure">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(Model => Model.ProcedureId)
            <div class="form-group">
                <label asp-for="ProcedureName" class="control-label"></label>
                <input asp-for="ProcedureName" class="form-control" />
                <span asp-validation-for="ProcedureName" class="text-danger"></span>
            </div>
            <div style="text-align: center;">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                    <button class="btn btn-primary" style="padding-left: 10px;" asp-action="Procedures" class="btn btn-primary">Regresar a Procedimientos</button>

            </div>
        </form>
    </div>
</div>
</center>