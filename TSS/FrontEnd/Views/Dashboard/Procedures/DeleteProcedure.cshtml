@model FrontEnd.Models.ProcedureViewModel

@{
    ViewData["Title"] = "DeleteProcedure";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}
<center>
    <h1>Eliminar Procedimiento</h1>

    <h3>¿Desea eliminarlo?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ProcedureName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.ProcedureName)
            </dd>
        </dl>

        <form asp-action="DeleteProcedure">
            @Html.HiddenFor(Model => Model.ProcedureId)
            <input type="submit" value="Eliminar" class="btn btn-danger" /> |
            <a asp-action="Procedures">Regresar a Procedimientos</a>
        </form>
    </div>
</center>