@model FrontEnd.Models.ProcedureViewModel

@{
    ViewData["Title"] = "ProcedureDetails";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center><h1>Registro de Procedimientos</h1></center>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProcedureName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProcedureName)
        </dd>
    </dl>
</div>
<div style="text-align: center;">
    @Html.ActionLink("Edit", "EditProcedure", new {  id = Model.ProcedureId }) |
    <a asp-action="Procedures">Regresar a Procedimientos</a>
</div>
