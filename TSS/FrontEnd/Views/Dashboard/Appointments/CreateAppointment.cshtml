<div class="container mt-5">
    <form asp-action="CreateAppointment">
        <div class="col">
            @Html.DropDownListFor(model => model.DoctorId, (SelectList)ViewBag.Doctors, "Select Doctor", new { @class = "form-control" })
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>
        <br />
        <div class="col">
            @Html.DropDownListFor(model => model.SpecialtyId, (SelectList)ViewBag.Specialties, "Select Specialty", new { @class = "form-control" })
            <span asp-validation-for="SpecialtyId" class="text-danger"></span>
        </div>
        <table class="table table-bordered">
            <br />
            <thead>
                <tr>
                    <th>Espacios de Citas</th>
                    @for (int i = 0; i < 10; i++)
                    {
                        var nextDate = today.AddDays(i);
                        <th>@nextDate.ToString("yyyy-MM-dd")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = 9; hour <= 18; hour++)
                {
                    <tr>
                        <td>@hour:00</td>
                        @for (int i = 0; i < 10; i++)
                        {
                            var nextDate = today.AddDays(i);
                            <td>
                                <input type="checkbox" name="StartTime" value="@nextDate.ToString("yyyy-MM-dd") @hour:00" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit" class="btn btn-primary">Crear Citas</button>
    </form>
</div>
