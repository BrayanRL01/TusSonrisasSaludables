@model FrontEnd.Models.VWAdminAppointmentViewModel

@{
    ViewData["Title"] = "DeleteAppointment";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}
@*
<h1>Eliminar cita</h1>*@

<center><h3>¿Seguro que desea eliminar?</h3></center>
<div>
   @* <h4>Citas Administrador</h4>*@
    <hr />
    <div style="text-align: center; padding-left:180px;">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Doctor)
        </dt>
        <dd class="col-sm-10">
