


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Availability Table</title>
    <!-- Include Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</head>
<body>

    <div class="container mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>

                    <th>Espacios de citas disponibles para el doctor</th>
                    <!-- Dynamically generate date headers for the next 30 days -->
                    <script>
                        const today = new Date();
                        for (let i = 0; i < 10; i++) {
                            const nextDate = new Date(today);
                            nextDate.setDate(today.getDate() + i);
                            document.write(`<th>${nextDate.toISOString().slice(0, 10)}</th>`);
                        }
                    </script>
                </tr>
            </thead>
            <tbody>
                <!-- Dynamically generate rows for times between 9 AM and 6 PM -->
                <script>
                    for (let hour = 9; hour <= 18; hour++) {
                        document.write(`<tr>`);
                        document.write(`<td>${hour}:00</td>`);
                        for (let i = 0; i < 10; i++) {
                            const nextDate = new Date(today);
                            nextDate.setDate(today.getDate() + i);
                            document.write(`
                                                                                            <td>
                                                                                                <button class="btn btn-sm btn-danger toggle-btn" data-date="${nextDate.toISOString().slice(0, 10)}" data-time="${hour}:00">Not Available</button>
                                                                                            </td>
                                                                                        `);
                        }
                        document.write(`</tr>`);
                    }
                </script>
            </tbody>
        </table>
    </div>

    <script>
        // Toggle button text and make AJAX call
        $(".toggle-btn").click(function () {
            const date = $(this).data('date');
            const time = $(this).data('time');
            if ($(this).text() === 'Not Available') {
                $(this).text('Available').removeClass('btn-danger').addClass('btn-primary');;
            } else {
                $(this).text('Not Available').removeClass('btn-primary').addClass('btn-danger');;
            }

            // Make an AJAX call with the date and time data
            $.ajax({
                url: '', // replace with your endpoint URL
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ date: date, time: time }),
                success: function (response) {
                    console.log(response);
                },
                error: function (error) {
                    console.log(error);
                }
            });
        });
    </script>
</body>
</html>


@{
    var today = DateTime.Today;
}

<div class="container mt-5">
    <form method="post" action="/your-endpoint-url">
        <!-- replace with your endpoint URL -->
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Espacios de citas disponibles para el doctor</th>
                    @for (int i = 0; i < 10; i++)
                    {
                    var nextDate = today.AddDays(i);
                    <th>@nextDate.ToString("yyyy-MM-dd")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = 9; hour <= 18; hour++)
                {
                <tr>
                    <td>@hour:00</td>
                    @for (int i = 0; i < 10; i++)
                    {
                    var nextDate = today.AddDays(i);
                    <td>
                        <input type="checkbox" name="appointments" value="@nextDate.ToString(" yyyy-MM-dd")-@hour:00" />
                    </td>
                    }
                    }
                </tr>
                }
            </tbody>
        </table>
        <button type="submit" class="btn btn-primary">Crear citas</button>
    </form>
</div>
