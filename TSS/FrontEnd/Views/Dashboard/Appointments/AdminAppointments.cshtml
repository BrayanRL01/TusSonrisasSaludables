@model IEnumerable<FrontEnd.Models.VWAdminAppointmentViewModel>

@{
    ViewData["Title"] = "AdminAppointments";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}


@if (TempData.ContainsKey("Message"))
{
    <div class="alert alert-success" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
else if (TempData.ContainsKey("Error"))
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Maneja el clic en el botón para generar el informe
        document.getElementById("generarInforme").addEventListener("click", function () {
            // Obtén los datos del formulario
            var doctor = document.getElementById("Doctor").value;
            var pacientName = document.getElementById("PacientName").value;
            var specialtyName = document.getElementById("SpecialtyName").value;
            var startTime = document.getElementById("StartTime").value;
            var endTime = document.getElementById("EndTime").value;


            // Crea un objeto con los datos del formulario
            var formData = {
                Doctor: doctor,
                PacientName: pacientName,
                SpecialtyName: specialtyName,
                StartTime: startTime,
                EndTime: endTime,
            };

            // Realiza una solicitud AJAX para generar el informe PDF
            fetch('/Pdf/GenerarCitaPDF', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            })
                .then(response => response.blob())
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'Informe.pdf';
                    a.style.display = 'none';
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                });
        });
    });
</script>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Citas</h6>
        <br />
        <a class="m-0 font-weight-bold text-primary" asp-action="CreateAppointment">Crear Cita</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Doctor)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PacientName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SpecialtyName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.StartTime)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.EndTime)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td id="Doctor">
                                @Html.DisplayFor(modelItem => item.Doctor, new { @id = "Doctor" })
                            </td>
                            <td id="PatientName">
                                @Html.DisplayFor(modelItem => item.PacientName, new { @id = "PatientName" })
                            </td>
                            <td id="SpecialtyName">
                                @Html.DisplayFor(modelItem => item.SpecialtyName, new { @id = "SpecialtyName" })
                            </td>
                            <td id="StartTime">
                                @Html.DisplayFor(modelItem => item.StartTime, new { @id = "StartTime" })
                            </td>
                            <td id="EndTime">
                                @Html.DisplayFor(modelItem => item.EndTime, new { @id = "EndTime" })
                            </td>
                            <td>
                                @Html.ActionLink("Editar", "EditAppointment", new { id = item.AppointmentId }, new { @class = "btn btn-warning" })
                                @Html.ActionLink("Detalles", "AppointmentDetails", new { id = item.AppointmentId }, new { @class = "btn btn-info" })
                                @Html.ActionLink("Eliminar", "DeleteAppointment", new { id = item.AppointmentId }, new { @class = "btn btn-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
