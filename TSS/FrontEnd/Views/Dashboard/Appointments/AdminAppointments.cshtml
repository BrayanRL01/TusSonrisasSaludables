@model IEnumerable<FrontEnd.Models.VWAdminAppointmentViewModel>

@{
    ViewData["Title"] = "AdminAppointments";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Categorías</h6>
        <br />
        <a class="m-0 font-weight-bold text-primary" asp-action="CreateAppointment">Crear Cita</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Doctor)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PacientName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SpecialtyName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.StartTime)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.EndTime)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Doctor)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PacientName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SpecialtyName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.StartTime)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EndTime)
                            </td>
                            <td>
                                @Html.ActionLink("Edit", "EditAppointment", new { id=item.AppointmentId }) |
                                @Html.ActionLink("Details", "AppointmentDetails", new { id=item.AppointmentId }) |
                                @Html.ActionLink("Delete", "DeleteAppointment", new { id=item.AppointmentId })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
