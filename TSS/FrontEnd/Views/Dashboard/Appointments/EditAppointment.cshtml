@model FrontEnd.Models.AppointmentViewModel

@{
    ViewData["Title"] = "EditAppointment";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditAppointment">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(Model => Model.AppointmentId)
            <div class="form-group">
                <label asp-for="DoctorId" class="control-label"></label>
                @Html.DropDownListFor(model => model.DoctorId, (SelectList)ViewBag.Doctors, "Seleccione un doctor", new { @class = "form-control" })
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SpecialtyId" class="control-label"></label>
                @Html.DropDownListFor(model => model.SpecialtyId, (SelectList)ViewBag.Specialties, "Seleccione una especialidad", new { @class = "form-control" })
                <span asp-validation-for="SpecialtyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndTime" class="control-label"></label>
                <input asp-for="EndTime" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div style="text-align: center;">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <button class="btn btn-primary" asp-action="Appointments">Regresar a Citas</button>
            </div>
        </form>
    </div>
</div>

