@model FrontEnd.Models.VWDoctorViewModel

@{
    ViewData["Title"] = "DeleteDoctor";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center>
    <center><h3>¿Seguro que desea eliminar?</h3></center>

    <div style="text-align: center; padding-left:180px;">
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.IdNumber)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.IdNumber)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.SpecialtyName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.SpecialtyName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.FullName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FullName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.BirthDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.BirthDate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Email)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Email)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.PhoneNumber)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DoctorPhoto)
            </dt>
            <dd class="col-sm-10">
                <partial name="Photo/_DoctorPhotoView" model="Model" />
            </dd>
        </dl>
        </div>
        <div style="text-align: center;">
        <form asp-action="DeleteDoctor">
            @Html.HiddenFor(Model => Model.DoctorId)
            <input type="submit" value="Eliminar" class="btn btn-danger" />
                <button class="btn btn-primary" asp-action="Doctors">Regresar a Doctores</button>
               
        </form>
    </div>
</center>
