@model FrontEnd.Models.DoctorViewModel

@{
    ViewData["Title"] = "EditDoctor";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center><h1>Editar Doctor</h1></center>

<hr />
<div class="row">
    <div class="col">
        <form asp-action="EditDoctor">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(Model => Model.DoctorId)
            <div class="col">
                <label asp-for="TypeId" class="form-label"></label>
                @Html.DropDownListFor(model => model.TypeId, (SelectList)ViewBag.Types, "Seleccione un tipo", new { @class = "form-control" })
                <span asp-validation-for="TypeId" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="SpecialtyId" class="control-label"></label>
                @Html.DropDownListFor(model => model.SpecialtyId, (SelectList)ViewBag.Specialties, "Seleccione una especialidad", new { @class = "form-control" })
                <span asp-validation-for="SpecialtyId" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="GenreId" class="form-label"></label>
                @Html.DropDownListFor(model => model.GenreId, (SelectList)ViewBag.Genres, "Seleccione un género", new { @class = "form-control" })
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="IdNumber" class="control-label"></label>
                <input asp-for="IdNumber" class="form-control" />
                <span asp-validation-for="IdNumber" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="DoctorName" class="control-label"></label>
                <input asp-for="DoctorName" class="form-control" />
                <span asp-validation-for="DoctorName" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="BirthDate" class="control-label"></label>
                <input asp-for="BirthDate" class="form-control" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <br />
            <div style="text-align: center;">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <button class="btn btn-primary" asp-action="Doctors">Regresar a Doctores</button>
            </div>
        </form>
    </div>
</div>
<hr />

<center><h1>Editar Imagen</h1></center>

<hr />
<div class="row">
    <div class="col">
        <form asp-action="EditDoctorImage" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(Model => Model.DoctorId)
            @Html.HiddenFor(Model => Model.SpecialtyId)
            @Html.HiddenFor(Model => Model.TypeId)
            @Html.HiddenFor(Model => Model.IdNumber)
            @Html.HiddenFor(Model => Model.BirthDate)
            @Html.HiddenFor(Model => Model.Email)
            @Html.HiddenFor(Model => Model.DoctorName)
            @Html.HiddenFor(Model => Model.LastName)
            @Html.HiddenFor(Model => Model.FirstName)
            @Html.HiddenFor(Model => Model.PhoneNumber)
            <div class="col">
                <input type="file" asp-for="DoctorPhoto" class="form-control" name="files" />
                <span asp-validation-for="DoctorPhoto" class="text-danger"></span>
            </div>
            <br />
            <div style="text-align: center;">
                <partial name="Photo/_DoctorPhoto" model="Model" />
            </div>
            <br />
            <div style="text-align: center;">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <button class="btn btn-primary" asp-action="Doctors">Regresar a Doctores</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}