@model FrontEnd.Models.VWSubCategoryViewModel

@{
    ViewData["Title"] = "DeleteSubCategory";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center>
    <h1>Eliminar Subcategoría</h1>
</center>
<hr />


<center><h3>¿Esta seguro de eliminar esta subcategoría?</h3></center>
<div style="text-align: center; padding-left:180px;">
@*    <h4>VWSubCategoryViewModel</h4>*@
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MainCategory)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MainCategory)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SubCategory)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SubCategory)
        </dd>
    </dl>
</div>

<div style="text-align: center;">
    <form asp-action="DeleteSubCategory">
        @Html.HiddenFor(Model => Model.CategoryId)
        <input type="submit" value="Eliminar" class="btn btn-danger" /> 
        <button class="btn btn-primary" asp-action="SubCategories">Regresar a Subcategorías</button>  
    </form>
</div>
