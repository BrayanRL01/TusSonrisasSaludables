@model FrontEnd.Models.CategoryViewModel

@{
    ViewData["Title"] = "EditSubCategory";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center><h1>Editar SubCategoría</h1></center>

@*<h4>CategoryViewModel</h4>*@
<hr />
<div class="row">
    <div class="col">
        <form asp-action="EditSubCategory">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(Model => Model.CategoryId)
            <div class="col">
                <label asp-for="MainCategoryId" class="form-label"></label>
                @Html.DropDownListFor(model => model.MainCategoryId, (SelectList)ViewBag.Categories, "Seleccione una categoría", new { @class = "form-control" })
                <span asp-validation-for="MainCategoryId" class="text-danger"></span>
            </div>
            <br /> 
            <div class="col">
                <label asp-for="CategoryName" class="control-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <br />
            <div style="text-align: center;">
                <input type="submit" value="Modificar" class="btn btn-primary" />
                <button class="btn btn-primary" style="padding-left: 10px;" asp-action="SubCategories" class="btn btn-primary">Regresar a Subcategorías</button>
            </div>
        </form>
    </div>
</div>

