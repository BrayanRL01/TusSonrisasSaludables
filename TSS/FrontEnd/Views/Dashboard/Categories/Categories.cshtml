@model IEnumerable<FrontEnd.Models.VWCategoryViewModel>

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Categorías</h6>
        <br />
        <a class="m-0 font-weight-bold text-primary" asp-action="CreateCategory">Crear Categoría</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.CategoryName)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.CategoryName)
                            </td>
                            <td>
                                @Html.ActionLink("Edit", "EditCategory", new { id=item.CategoryId }) |
                                @Html.ActionLink("Details", "CategoryDetails", new { id=item.CategoryId }) |
                                @Html.ActionLink("Delete", "DeleteCategory", new { id=item.CategoryId })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
