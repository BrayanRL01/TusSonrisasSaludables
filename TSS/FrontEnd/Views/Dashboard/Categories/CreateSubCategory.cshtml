@model FrontEnd.Models.CategoryViewModel

@{
    ViewData["Title"] = "CreateSubCategory";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}
<center><h1>Crear SubCategoría</h1></center>
<hr />
<div class="row">
    <div class="col">
        <form asp-action="CreateSubCategory">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col">
               @* <label asp-for="MainCategoryId" class="form-label"></label>*@
                @Html.DropDownListFor(model => model.MainCategoryId, (SelectList)ViewBag.Categories, "Seleccione una categoría", new { @class = "form-control" })
                <span asp-validation-for="MainCategoryId" class="text-danger"></span>
            </div>
            <br />
            <div class="col">
                @*<label asp-for="CategoryName" class="control-label"></label>*@
                <input asp-for="CategoryName" class="form-control" placeholder="Nombre"/>
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <br /> 
            <div style="text-align: center;">
                <input type="submit" value="Crear" class="btn btn-primary" />             
                <button class="btn btn-primary" asp-action="SubCategories">Regresar a Subcategorías</button>
                </div>          
        </form>
    </div>
</div>

@*<div>
    <a asp-action="SubCategories">Volver a Subcategorías</a>
</div>*@

