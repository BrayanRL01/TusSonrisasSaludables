@model FrontEnd.Models.BrandViewModel

@{
    ViewData["Title"] = "BrandDetails";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<h1>Detalle de Marca</h1>

<div>
    <hr />
    <dl class="row">
        @Html.HiddenFor(Model => Model.BrandId)
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BrandName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BrandName)
        </dd>
    </dl>
</div>
<div style="text-align: center;">
    @Html.ActionLink("Editar", "EditBrand", new { id = Model.BrandId }) |
    <a asp-action="Brands">Regresar a Marcas</a>
</div>
