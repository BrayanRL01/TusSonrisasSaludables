@model FrontEnd.Models.BrandViewModel

@{
    ViewData["Title"] = "EditBrand";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center><h1>Editar Marca</h1></center>

@*<h4>BrandViewModel</h4>*@
<hr />
<div class="row">
    <div class="col">
        <form asp-action="EditBrand">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(Model => Model.BrandId)
            <div class="col">
                <label asp-for="BrandName" class="control-label"></label>
                <input asp-for="BrandName" class="form-control" />
                <span asp-validation-for="BrandName" class="text-danger"></span>
            </div>
            <br />
            <div style="text-align: center;">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <button class="btn btn-primary" style="padding-left: 10px;" asp-action="Brands" class="btn btn-primary">Regresar a marcas</button>
               
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}