@model FrontEnd.Models.BrandViewModel

@{
    ViewData["Title"] = "DeleteBrand";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<h1>Eliminar Marca</h1>

<h3>Esta seguro de eliminar esta Marca?</h3>
<div>
    <h4>BrandViewModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BrandName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BrandName)
        </dd>
    </dl>

    <form asp-action="DeleteBrand">
        @Html.HiddenFor(Model => Model.BrandId)
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a Marcas</a>
    </form>
</div>
