@model IEnumerable<FrontEnd.Models.BrandViewModel>

@{
    ViewData["Title"] = "Brands";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<h1>Brands</h1>

<p>
    <a asp-action="CreateBrand">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BrandName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.BrandName)
                </td>
                <td>
                    @Html.ActionLink("Edit", "EditBrand", new { id=item.BrandId }) |
                    @Html.ActionLink("Details", "BrandDetails", new { id=item.BrandId }) |
                    @Html.ActionLink("Delete", "DeleteBrand", new { id=item.BrandId })
                </td>
            </tr>
        }
    </tbody>
</table>
