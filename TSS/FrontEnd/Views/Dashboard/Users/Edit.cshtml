@model FrontEnd.Models.UserViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "_DashLayout";
}

<center> <h1>Editar Usuario</h1> </center>

@*
<h4>UserViewModel</h4>*@
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger" align="center"></div>
            @Html.HiddenFor(Model => Model.UserId)
            @Html.HiddenFor(Model => Model.RoleId)
            <div class="form-group row">
                <label asp-for="TypeId" readonly class="control-label" align="center"></label>
                @Html.DropDownListFor(model => model.TypeId, (SelectList)ViewBag.IDTypes, "Seleccione un tipo", new { @class = "form-control" })
                <span asp-validation-for="TypeId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group row">
                <label asp-for="GenreId" class="control-label" align="center"></label>
                @Html.DropDownListFor(model => model.GenreId, (SelectList)ViewBag.Genres, "Seleccione un género", new { @class = "form-control" })
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group row">
                <label asp-for="ProvinceId" class="control-label" align="center"></label>
                @Html.DropDownListFor(model => model.ProvinceId, (SelectList)ViewBag.Provinces, "Seleccione una provincia", new { @class = "form-control" })
                <span asp-validation-for="ProvinceId" class="text-danger" align="center"></span>
            </div>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="IdNumber" class="control-label" align="center"></label>
                    <input asp-for="IdNumber" class="form-control" />
                    <span asp-validation-for="IdNumber" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="UserName" class="control-label" align="center"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="FirstName" class="control-label" align="center"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="LastName" class="control-label" align="center"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="BirthDate" class="control-label" align="center"></label>
                    <input asp-for="BirthDate" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="Email" class="control-label" align="center"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="PhoneNumber" class="control-label" align="center"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            <center>
                <div class="form-group">
                    <label asp-for="UserAddress" class="control-label" align="center"></label>
                    <input asp-for="UserAddress" class="form-control" />
                    <span asp-validation-for="UserAddress" class="text-danger" align="center"></span>
                </div>
            </center>
            <br />
            @*             <center>
            <div class="form-group">
            <label asp-for="PasswordHash" class="control-label" align="center"></label>
            <input asp-for="PasswordHash" class="form-control" />
            <span asp-validation-for="PasswordHash" class="text-danger" align="center"></span>
            </div>
            </center> *@
            <br />
            <div style="text-align: center;">
                <input type="submit" value="Save" class="btn btn-primary" />
                @Html.ActionLink("Volver a Usuarios", "Index", new { id = Model.UserId }, new { @class = "btn btn-primary" })
            </div>

        </form>
    </div>
</div>

<div>
    @*  <a asp-action="Index">Volver a Usuario</a>*@
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
