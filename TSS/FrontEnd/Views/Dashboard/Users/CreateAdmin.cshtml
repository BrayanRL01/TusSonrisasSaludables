@model FrontEnd.Models.UserViewModel

@{
    ViewData["Title"] = "CreateAdmin";
    Layout = "_DashLayout";
}

<center><h1> Bienvenido a la Creación de Administradores </h1></center>
<br /> 
<div class="row">
    <div class="col">
        <form asp-action="CreateAdmin">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                @*<label asp-for="TypeId" class="form-label"></label>*@
                @Html.DropDownListFor(model => model.TypeId, (SelectList)ViewBag.IDTypes, "Seleccione un tipo", new { @class = "form-control" })
                <span asp-validation-for="TypeId" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group">
             @*   <label asp-for="GenreId" class="form-label"></label>*@
                @Html.DropDownListFor(model => model.GenreId, (SelectList)ViewBag.Genres, "Seleccione un género", new { @class = "form-control" })
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>
            <br /> 
           
            <div class="form-group">
                @*<label asp-for="ProvinceId" class="form-label"></label>*@
                @Html.DropDownListFor(model => model.ProvinceId, (SelectList)ViewBag.Provinces, "Seleccione una provincia", new { @class = "form-control" })
                <span asp-validation-for="ProvinceId" class="text-danger"></span>
            </div>
            <br />
          
            <div class="row">
                <div class="col">
                    <input type="text" class="form-control" placeholder="Nombre">
                </div>
                <br />
                <div class="col">
                    <input type="text" class="form-control" placeholder="Apellidos">
                </div>
            </div>
            <br/>

            <div class="row">
                <div class="col">
                    <input type="text" class="form-control" placeholder="Correo">
                </div>
     
                <div class="col">
                    <input type="text" class="form-control" placeholder="Nombre de Usuario">
                </div>
            </div>
            <br />
     
            <div class="row">
                <div class="col">
                    <input type="email" class="form-control" placeholder="UserAdress">
                </div>
                <div class="col">
                    <input type="password" class="form-control" id="inputPassword4" placeholder="Contraseña">
                </div>
            </div>

            <br />

            <div class="row">
                <div class="col">
                    <input type="text" class="form-control" placeholder="Identificación">
                </div>
                <br />
                <div class="col">
                    <input type="text" class="form-control" placeholder="Número Telefónico">
                </div>
            </div>

            <br />


            <div class="form-group">
                <label asp-for="BirthDate" class="form-label"></label>
                <input asp-for="BirthDate" class="form-control" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>


            <br />

            <div class="form-group text-center">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <button class="btn btn-primary" asp-action="Users">Volver a Usuarios</button>
            </div>



            @*<div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <button class="btn btn-primary" asp-action="Users">Volver a Usuarios</button>
            </div>*@



        </form>
    </div>
</div>

@*<div>
    <a asp-action="Users">Volver a Usuarios</a>
</div>*@

