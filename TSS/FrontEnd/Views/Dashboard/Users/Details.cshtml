@model FrontEnd.Models.VWUserViewModel

@{
    ViewData["Title"] = "Details";
    Layout = "_DashLayout";
}

<center><h1>Detalle Usuario</h1></center>

<div>
    @*  <h4>VWUserViewModel</h4>*@
    <hr />
    <dl class="row">
        @Html.HiddenFor(Model => Model.UserId)
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdNumber)
        </dd>
        @*        <dd class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" id="staticEmail" value="@Html.DisplayFor(model => model.IdNumber)">
        </dd> *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProvinceName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProvinceName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GenreName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.GenreName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BirthDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BirthDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
    </dl>
</div>
<div>

    <div class="form-group text-center">
        @Html.ActionLink("Editar", "Edit", new { id = Model.UserId }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Volver a Usuarios", "Index", new { id = Model.UserId }, new { @class = "btn btn-primary" })
    </div>

    @* @Html.ActionLink("Edit", "Edit", new { id = Model.UserId }) |
    <a asp-action="Index">Volver a Usuario</a>*@
</div>
