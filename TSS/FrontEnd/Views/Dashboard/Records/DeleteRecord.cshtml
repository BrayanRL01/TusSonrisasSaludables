@model FrontEnd.Models.VWRecordViewModel

@{
    ViewData["Title"] = "DeleteRecord";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}
@*
<h1>DeleteRecord</h1>*@

<center><h3>¿Seguro que desea eliminar?</h3></center>
    <div style="text-align: center; padding-left:180px;">
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PatientName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PatientName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DoctorName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DoctorName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProcedureName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProcedureName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Diagnoses)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Diagnoses)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Symptoms)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Symptoms)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Treatment)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Treatment)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RecordDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RecordDate)
        </dd>
    </dl>
    </div>

    <div style="text-align: center;">
    <form asp-action="DeleteRecord">
        @Html.HiddenFor(Model => Model.RecordId)
        <input type="submit" value="Eliminar" class="btn btn-danger" /> 
        <button class="btn btn-primary" asp-action="Records">Regresar a Registros</button>

        </form>
</div>
