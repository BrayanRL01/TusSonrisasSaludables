@model IEnumerable<FrontEnd.Models.VWRecordViewModel>

@{
    ViewData["Title"] = "Records";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

@if (TempData.ContainsKey("Message"))
{
    <div class="alert alert-success" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData.ContainsKey("Error"))
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Registros</h6>
        <br />
        <a class="m-0 font-weight-bold text-primary" asp-action="CreateRecord">Crear Registro</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.PatientName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DoctorName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProcedureName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Diagnoses)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Symptoms)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Treatment)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.RecordDate)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.PatientName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DoctorName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProcedureName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Diagnoses)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Symptoms)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Treatment)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.RecordDate)
                            </td>
                            <td>
                                @Html.ActionLink("Edit", "EditRecord", new { id=item.RecordId }) |
                                @Html.ActionLink("Details", "RecordDetails", new { id=item.RecordId }) |
                                @Html.ActionLink("Delete", "DeleteRecord", new { id=item.RecordId })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>