@model IEnumerable<FrontEnd.Models.SpecialtyViewModel>

@{
    ViewData["Title"] = "Specialties";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

@if (TempData.ContainsKey("Message"))
{
    <div class="alert alert-success" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
else if (TempData.ContainsKey("Error"))
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<p>
    <a asp-action="CreateSpecialty">Crear nueva especialidad</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SpecialtyName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.SpecialtyName)
                </td>
                <td>
                    @Html.ActionLink("Editar", "EditSpecialty", new { id=item.SpecialtyId }, new {@class="btn btn-warning" } )
                    @Html.ActionLink("Detalles", "SpecialtyDetails", new { id=item.SpecialtyId },new {@class="btn btn-info" } )
                    @Html.ActionLink("Eliminar", "DeleteSpecialty", new { id=item.SpecialtyId },new {@class="btn btn-danger" } )
                </td>
            </tr>
        }
    </tbody>
</table>
