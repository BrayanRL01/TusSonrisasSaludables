@model IEnumerable<FrontEnd.Models.SpecialtyViewModel>

@{
    ViewData["Title"] = "Specialties";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<p>
    <a asp-action="CreateSpecialty">Crear nueva especialidad</a>
</p>
@if (TempData.ContainsKey("Message"))
{
    <div class="alert success-danger" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SpecialtyId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SpecialtyName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.SpecialtyId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SpecialtyName)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Details", "SpecialtyDetails", new { id=item.SpecialtyId }) |
                    @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                </td>
            </tr>
        }
    </tbody>
</table>
</div>