@model IEnumerable<FrontEnd.Models.SpecialtyViewModel>

@{
    ViewData["Title"] = "Specialties";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

@if (TempData.ContainsKey("Message"))
{
    <div class="alert alert-success" role="alert">
        @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
else if (TempData.ContainsKey("Error"))
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Especialidades</h6>
        <br />
        <a class="m-0 font-weight-bold text-primary" asp-action="CreateSpecialty">Crear Doctor</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.SpecialtyName)
                        </th>
                        <th>
                            @Html.DisplayName("Acciones")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.SpecialtyName)
                            </td>
                            <td>
                                @Html.ActionLink("Edit", "EditSpecialty", new { id=item.SpecialtyId }) |
                                @Html.ActionLink("Details", "SpecialtyDetails", new { id=item.SpecialtyId }) |
                                @Html.ActionLink("Delete", "DeleteSpecialty", new { id=item.SpecialtyId })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>