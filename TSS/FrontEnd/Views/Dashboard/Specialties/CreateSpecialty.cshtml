@model FrontEnd.Models.SpecialtyViewModel

@{
    ViewData["Title"] = "CreateSpecialty";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}
<center><h1>Crear Especialidad</h1></center>

<hr />
<div class="row">
    <div class="col">
        <form asp-action="CreateSpecialty">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col">
                @*<label asp-for="SpecialtyName" class="control-label"></label>*@
                <input asp-for="SpecialtyName" class="form-control" placeholder="Especialidad" />
                <span asp-validation-for="SpecialtyName" class="text-danger"></span>
            </div>
            <br /> 
            <div style="text-align: center;">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a class="btn btn-primary" asp-action="Specialties">Regresar a Especialidades</a>
@*                <button class="btn btn-primary" asp-action="Specialties">Regresar a Especialidades</button>
*@         
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}