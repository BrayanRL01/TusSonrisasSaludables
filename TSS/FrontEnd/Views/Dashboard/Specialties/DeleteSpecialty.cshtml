@model FrontEnd.Models.SpecialtyViewModel

@{
    ViewData["Title"] = "DeleteSpecialty";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center><h3>¿Seguro que desea eliminar?</h3></center>
<div style="text-align: center; padding-left:180px;">
    @*<h4>SpecialtyViewModel</h4>*@
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SpecialtyName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SpecialtyName)
        </dd>
    </dl>
    </div>

<div style="text-align: center;">
    <form asp-action="DeleteSpecialty">
        @Html.HiddenFor(Model => Model.SpecialtyId)
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <button class="btn btn-primary" asp-action="Specialties">Regresar a Especialidades</button>
    </form>
</div>
