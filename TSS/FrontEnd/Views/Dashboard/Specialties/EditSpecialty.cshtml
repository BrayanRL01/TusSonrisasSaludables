@model FrontEnd.Models.SpecialtyViewModel

@{
    ViewData["Title"] = "EditSpecialty";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center>
    <h1>Editar Especialidad</h1>
</center>
<hr />

<div class="row">
    <div class="col">
        <form asp-action="EditSpecialty">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col">
                @Html.HiddenFor(Model => Model.SpecialtyId)
                <div class="form-group">
                    <label asp-for="SpecialtyName" class="control-label"></label>
                    <input asp-for="SpecialtyName" class="form-control" />
                    <span asp-validation-for="SpecialtyName" class="text-danger"></span>
                </div>
                <div style="text-align: center;">
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                    <button class="btn btn-primary" style="padding-left: 10px;" asp-action="Specialties" class="btn btn-primary">Regresar a Especialidades</button>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

