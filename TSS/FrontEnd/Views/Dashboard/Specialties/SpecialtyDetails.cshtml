@model FrontEnd.Models.SpecialtyViewModel

@{
    ViewData["Title"] = "SpecialtyDetails";
    Layout = "~/Views/Shared/_DashLayout.cshtml";
}

<center>
    <h1>Registro de Especialidades</h1>
</center>

<div>
    <hr />
    <dl class="row" style="padding-left: 570px;">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SpecialtyName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SpecialtyName)
        </dd>
    </dl>
</div>
<div style="text-align: center;">
    @Html.ActionLink("Editar", "EditSpecialty", new { id = Model.SpecialtyId }) |
    <a asp-action="Specialties">Regresar a Especialidades</a>
</div>
